{
  "$schema": "./frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AirSlate PC Server",
  "mainBinaryName": "airslate_pc_server",
  "version": "1.8.0",
  "identifier": "com.airslate.pcserver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "./frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AirSlate 控制台",
        "width": 2064,
        "height": 1232,
        "minWidth": 960,
        "minHeight": 540,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "template": "./assets/windows/tauri-main.wxs"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-airslate.rules": "assets/linux/70-airslate.rules"
        },
        "postInstallScript": "assets/linux/post-install.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-airslate.rules": "assets/linux/70-airslate.rules"
        },
        "postInstallScript": "assets/linux/post-install.sh"
      }
    },
    "icon": [
      "assets/icons/32x32.png",
      "assets/icons/128x128.png",
      "assets/icons/icon.ico",
      "assets/icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2QThCMkI3ODIyQjgyQUYKUldTdmdpdUN0N0tvRmdMZ3VIcWRlMnlMYzZQdktFUEdaWlA5ci9CSHBjVE1idmRoRzJjV09sbUIK",
      "endpoints": [
        "https://github.com/2doright/airslate-pc-server/releases/latest/download/latest.json"
      ]
    }
  }
}
