{
  "$schema": "./node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AirSlate PC Server",
  "version": "1.4.10",
  "identifier": "com.airslate.pcserver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "./frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "template": "./windows/tauri-installer.nsi"
      },
      "wix": {
        "template": "./windows/tauri-main.wxs"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
